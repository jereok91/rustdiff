{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "RustDiff",
    "mainBinaryName": "rustdiff",
    "version": "1.0.0",
    "identifier": "com.digitalgex.RustDiff",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "RustDiff",
                "width": 1100,
                "height": 720,
                "minWidth": 640,
                "minHeight": 400
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "deb"
        ],
        "category": "Utility",
        "shortDescription": "Semantic JSON, XML and SQL comparator",
        "longDescription": "RustDiff compares the structure of JSON, XML and SQL documents: keys, array indices, XML nodes and attributes, and SQL statements.",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.png"
        ],
        "copyright": "2026 digitalgex",
        "license": "GPL-3.0-or-later",
        "linux": {
            "deb": {
                "section": "utils",
                "priority": "optional",
                "desktopTemplate": "../../data/com.digitalgex.RustDiff.desktop",
                "files": {
                    "/usr/share/metainfo/com.digitalgex.RustDiff.metainfo.xml": "../../data/com.digitalgex.RustDiff.metainfo.xml",
                    "/usr/share/icons/hicolor/scalable/apps/com.digitalgex.RustDiff.svg": "../../data/icons/com.digitalgex.RustDiff.svg"
                }
            }
        },
        "macOS": {
            "signingIdentity": "-"
        }
    }
}
