[Desktop Entry]
# ── Información básica ──────────────────────────────────────────────
Name=RustDiff
Name[es]=RustDiff
GenericName=JSON, XML & SQL Comparator
GenericName[es]=Comparador de JSON, XML y SQL
Comment=Compare JSON, XML and SQL documents by structure
Comment[es]=Compara documentos JSON, XML y SQL por su estructura
Icon=com.digitalgex.RustDiff
Exec=rustdiff %F
Terminal=false
Type=Application

# ── Categorías (clasifica la app en el menú del sistema) ────────────
Categories=Utility;Development;TextEditor;

# ── Tipos MIME que puede abrir la app ──────────────────────────────
MimeType=application/json;application/xml;text/xml;text/json;application/sql;text/x-sql;

# ── Palabras clave para búsqueda ───────────────────────────────────
Keywords=json;xml;diff;compare;format;lint;validate;
Keywords[es]=json;xml;diff;comparar;formato;validar;

# ── Integración con el escritorio ──────────────────────────────────
# Aparece en la búsqueda de GNOME/KDE
StartupNotify=true
# La app es Tauri (GTK3 + WebKitGTK): su WM_CLASS / app_id de Wayland es el
# prgname de GTK, es decir el nombre del binario. Sin esto el shell no asocia
# la ventana con este .desktop y muestra un icono genérico.
StartupWMClass=rustdiff

# ── Acciones rápidas (click derecho en el ícono) ───────────────────
# (La acción "Abrir Historial" se retiró en 1.0.0: el shell Tauri solo
# entiende rutas de archivo en la línea de comandos.)
Actions=NewComparison;

[Desktop Action NewComparison]
Name=New Comparison
Name[es]=Nueva Comparación
Exec=rustdiff
Icon=com.digitalgex.RustDiff
