{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "RustDiff",
    "version": "0.4.0",
    "identifier": "com.digitalgex.RustDiff",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "RustDiff",
                "width": 1100,
                "height": 720,
                "minWidth": 640,
                "minHeight": 400
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["deb"],
        "category": "Utility",
        "shortDescription": "Semantic JSON, XML and SQL comparator",
        "longDescription": "RustDiff compares the structure of JSON, XML and SQL documents: keys, array indices, XML nodes and attributes, and SQL statements.",
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
    }
}
